<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 로그 파일 경로 설정 -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="LOG_FILE" value="${LOG_FILE:-custom-api-svc}"/>
    
    <!-- 개발 환경용 콘솔 출력 -->
    <springProfile name="dev,docker">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        
        <logger name="org.example.customapisvc" level="DEBUG"/>
        <logger name="org.springframework.security" level="DEBUG"/>
    </springProfile>
    
    <!-- 프로덕션 환경용 JSON 로깅 -->
    <springProfile name="!dev">
        <!-- 콘솔 JSON 출력 (컨테이너 로그 수집용) -->
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>true</includeContext>
                <includeMdc>true</includeMdc>
                <customFields>{"service":"custom-api-svc","pid":"${PID:-}","version":"${BUILD_VERSION:-dev}","environment":"${SPRING_PROFILES_ACTIVE:-unknown}","host":"${HOSTNAME:-unknown}","container_id":"${CONTAINER_ID:-unknown}"}</customFields>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <level>level</level>
                    <thread>thread</thread>
                    <logger>logger</logger>
                    <message>message</message>
                    <stackTrace>stack_trace</stackTrace>
                </fieldNames>
            </encoder>
        </appender>
        
        <!-- 파일 JSON 출력 -->
        <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/${LOG_FILE}.json</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/${LOG_FILE}.%d{yyyy-MM-dd}.%i.json</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>true</includeContext>
                <includeMdc>true</includeMdc>
                <customFields>{"service":"custom-api-svc","pid":"${PID:-}","version":"${BUILD_VERSION:-dev}","environment":"${SPRING_PROFILES_ACTIVE:-unknown}","host":"${HOSTNAME:-unknown}","container_id":"${CONTAINER_ID:-unknown}"}</customFields>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <level>level</level>
                    <thread>thread</thread>
                    <logger>logger</logger>
                    <message>message</message>
                    <stackTrace>stack_trace</stackTrace>
                </fieldNames>
            </encoder>
        </appender>
        
        <!-- Logstash TCP 출력 (선택사항) -->
        <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${LOGSTASH_HOST:-localhost}:${LOGSTASH_PORT:-5000}</destination>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>true</includeContext>
                <includeMdc>true</includeMdc>
                <customFields>{"service":"custom-api-svc","pid":"${PID:-}","version":"${BUILD_VERSION:-dev}","environment":"${SPRING_PROFILES_ACTIVE:-unknown}","host":"${HOSTNAME:-unknown}","container_id":"${CONTAINER_ID:-unknown}"}</customFields>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <level>level</level>
                    <thread>thread</thread>
                    <logger>logger</logger>
                    <message>message</message>
                    <stackTrace>stack_trace</stackTrace>
                </fieldNames>
            </encoder>
        </appender>
        
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE_JSON"/>
            <!-- Logstash가 활성화된 경우에만 사용 -->
            <!-- <appender-ref ref="LOGSTASH"/> -->
        </root>
        
        <logger name="org.example.customapisvc" level="INFO"/>
        <logger name="org.springframework.kafka" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
    </springProfile>
    
    <!-- 특정 로거 설정 -->
    <logger name="org.springframework.security.web" level="WARN"/>
    <logger name="org.springframework.web.filter.CommonsRequestLoggingFilter" level="DEBUG"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="kafka" level="WARN"/>
    
    <!-- 민감한 정보 로깅 방지 -->
    <logger name="org.springframework.security.oauth2" level="WARN"/>
    <logger name="org.springframework.security.web.authentication" level="WARN"/>
</configuration>